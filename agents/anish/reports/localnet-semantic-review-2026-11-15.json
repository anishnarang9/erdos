  "requirementMap": [
    {
      "requirement": 1,
      "name": "Charge cardinality",
      "rules": [
        0,
        1
      ],
      "encoding": "unique charges.release_id, and count(charges) equals count(releases)",
      "judgment": "faithful"
    },
    {
      "requirement": 2,
      "name": "Charge quantity",
      "rules": [
        2
      ],
      "encoding": "every charge panels equals lookup(releases, release_id).panels",
      "judgment": "faithful",
      "note": "A missing release id aborts evaluation. It does not return verdict 0."
    },
    {
      "requirement": 3,
      "name": "Finish cardinality",
      "rules": [
        3,
        4
      ],
      "encoding": "unique finishes.release_id, and count(finishes) equals count(releases)",
      "judgment": "faithful"
    },
    {
      "requirement": 4,
      "name": "Coverage",
      "rules": [
        5
      ],
      "encoding": "every release has some charge and some finish with the same release_id",
      "judgment": "faithful",
      "note": "Uses any, so a missing stage is verdict 0 when no lookup aborts."
    },
    {
      "requirement": 5,
      "name": "Charge-finish join",
      "rules": [
        6
      ],
      "encoding": "every finish panels equals lookup(charges, release_id).panels",
      "judgment": "faithful",
      "note": "Charges are a lookup source. Any duplicate charge release_id aborts when this rule runs."
    },
    {
      "requirement": 6,
      "name": "Clay mass",
      "rules": [
        7
      ],
      "encoding": "clay_kg equals panels multiplied by lookup(profile through release).kg_per_panel",
      "judgment": "faithful"
    },
    {
      "requirement": 7,
      "name": "Lot",
      "rules": [
        8,
        9
      ],
      "encoding": "unique lot_id; family matches; clay_kg <= kg_available; certified equals 1",
      "judgment": "faithful"
    },
    {
      "requirement": 8,
      "name": "Kiln",
      "rules": [
        10,
        11
      ],
      "encoding": "unique kiln_id; inclusive thickness window; clay_kg <= capacity_kg; empty family_lock or exact family",
      "judgment": "faithful"
    },
    {
      "requirement": 9,
      "name": "Bench",
      "rules": [
        12,
        13
      ],
      "encoding": "unique bench_id; bench edge_code equals the profile edge_code",
      "judgment": "faithful"
    },
    {
      "requirement": 10,
      "name": "Temper",
      "rules": [
        14,
        15
      ],
      "encoding": "unique temper_id; inclusive thickness; panels <= capacity_panels; fire exactly when temper_required is 1 and bypass exactly when it is 0",
      "judgment": "faithful"
    },
    {
      "requirement": 11,
      "name": "Import ceiling",
      "rules": [
        16
      ],
      "encoding": "count of charges whose supplier import equals 1 is <= max_import_charges",
      "judgment": "faithful"
    },
    {
      "requirement": 12,
      "name": "Recycled floor",
      "rules": [
        17
      ],
      "encoding": "count of charges whose lot recycled equals 1 is >= min_recycled_charges",
      "judgment": "faithful"
    },
    {
      "requirement": 13,
      "name": "Spend ceiling",
      "rules": [
        18
      ],
      "encoding": "sum of clay_kg * lot.cents_per_kg is <= max_spend_cents",
      "judgment": "faithful"
    }
  ],
