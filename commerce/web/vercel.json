{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd .. && corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build --mode hosted",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/rpc",
      "destination": "https://rpc.testnet.arc.io"
    },
    {
      "source": "/healthz",
      "destination": "https://ubc26-159-89-149-133.sslip.io/healthz"
    },
    {
      "source": "/v1/open-jobs",
      "destination": "https://ubc26-159-89-149-133.sslip.io/v1/open-jobs"
    },
    {
      "source": "/v1/open-jobs/:id([0-9A-HJKMNP-TV-Z]{26})",
      "destination": "https://ubc26-159-89-149-133.sslip.io/v1/open-jobs/:id"
    }
  ],
  "headers": [
    {
      "source": "/site/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/site/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
