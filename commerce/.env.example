# Copy to the launching process's working-directory .env (api/ or worker/).
# Real-engine Vitest suites require exported shell variables; they do not load .env.
# Never commit real values.

# API
PORT=8787
DB_PATH=./commerce.db
BUYER_API_TOKEN=change-me-long-random-string

# Grok (T5)
XAI_API_KEY=
XAI_MODEL=

# API chain reader (Arc Testnet). Leave CHAIN_RPC_URL unset for offline mode.
# A configured chain requires an explicitly real engine; simulated/default engines are rejected.
CHAIN_ID=5042002
CHAIN_RPC_URL=
CHAIN_CORE=0x4992b29bc494a6d9A33D153850C0E40F15F0e9c8
CHAIN_HOOK=0x699d0e4a067F31229Be67C534B37dE964b6eDbAb
CHAIN_USDC=0x3600000000000000000000000000000000000000
INDEX_FROM_BLOCK=0

# Engine (T5/T6/T9). See README "Real engine". Default ENGINE_MODE=simulated (fake hashes, never provable).
ENGINE_MODE=wsl
ENGINE_PATH=/home/<you>/ubc26/engine-wt/engine/target/debug/engine
ENGINE_WSL_DISTRO=Ubuntu
ENGINE_R0VM=/home/<you>/.risc0/extensions/v3.1.0-cargo-risczero-x86_64-unknown-linux-gnu/r0vm
ENGINE_WORK_DIR='\\wsl.localhost\Ubuntu\home\<you>\ubc26\work'
PACKAGES_DIR='\\wsl.localhost\Ubuntu\home\<you>\ubc26\packages'
WORKER_DATA_DIR='\\wsl.localhost\Ubuntu\home\<you>\ubc26\attempts'

# Grok recording/replay (optional)
GROK_RECORD_DIR=
GROK_REPLAY_DIR=
