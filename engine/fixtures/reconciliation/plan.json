{
  "version": 1,
  "deliverables": [
    {
      "name": "result.json",
      "parser": "json/v1",
      "collections": [
        {
          "name": "rows",
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "amountCents",
              "type": "i64"
            }
          ]
        }
      ]
    },
    {
      "name": "report.txt",
      "parser": "text/v1"
    }
  ],
  "references": [
    {
      "name": "ledger.json",
      "parser": "json/v1",
      "collections": [
        {
          "name": "rows",
          "fields": [
            {
              "name": "id",
              "type": "string"
            },
            {
              "name": "amountCents",
              "type": "i64"
            }
          ]
        }
      ]
    }
  ],
  "rules": [
    {
      "op": "unique",
      "collection": {
        "source": "deliverable",
        "file": "result.json",
        "field": "rows"
      },
      "field": "id"
    },
    {
      "op": "eq",
      "left": {
        "op": "count",
        "collection": {
          "source": "deliverable",
          "file": "result.json",
          "field": "rows"
        }
      },
      "right": {
        "op": "count",
        "collection": {
          "source": "reference",
          "file": "ledger.json",
          "field": "rows"
        }
      }
    },
    {
      "op": "gte",
      "left": {
        "op": "count",
        "collection": {
          "source": "deliverable",
          "file": "result.json",
          "field": "rows"
        }
      },
      "right": {
        "op": "literal",
        "type": "i64",
        "value": "1"
      }
    },
    {
      "op": "eq",
      "left": {
        "op": "sum",
        "collection": {
          "source": "deliverable",
          "file": "result.json",
          "field": "rows"
        },
        "value": {
          "op": "record_field",
          "field": "amountCents"
        }
      },
      "right": {
        "op": "sum",
        "collection": {
          "source": "reference",
          "file": "ledger.json",
          "field": "rows"
        },
        "value": {
          "op": "record_field",
          "field": "amountCents"
        }
      }
    },
    {
      "op": "all",
      "collection": {
        "source": "deliverable",
        "file": "result.json",
        "field": "rows"
      },
      "where": {
        "op": "eq",
        "left": {
          "op": "record_field",
          "field": "amountCents"
        },
        "right": {
          "op": "lookup",
          "collection": {
            "source": "reference",
            "file": "ledger.json",
            "field": "rows"
          },
          "keyField": "id",
          "key": {
            "op": "record_field",
            "field": "id"
          },
          "valueField": "amountCents"
        }
      }
    }
  ]
}
