{
  "deliverables": [
    {
      "name": "artifact.dat",
      "parser": "text/v1"
    },
    {
      "name": "appendix.bin",
      "parser": "opaque/v1"
    },
    {
      "fields": [
        {
          "name": "label",
          "type": "string"
        }
      ],
      "name": "metadata.json",
      "parser": "json/v1"
    }
  ],
  "references": [
    {
      "name": "approved.dat",
      "parser": "opaque/v1"
    }
  ],
  "rules": [
    {
      "left": {
        "file": "artifact.dat",
        "op": "file_hash",
        "source": "deliverable"
      },
      "op": "eq",
      "right": {
        "file": "approved.dat",
        "op": "file_hash",
        "source": "reference"
      }
    },
    {
      "left": {
        "file": "appendix.bin",
        "op": "file_size",
        "source": "deliverable"
      },
      "op": "gte",
      "right": {
        "op": "literal",
        "type": "i64",
        "value": "6"
      }
    },
    {
      "left": {
        "file": "appendix.bin",
        "op": "file_size",
        "source": "deliverable"
      },
      "op": "lte",
      "right": {
        "op": "literal",
        "type": "i64",
        "value": "12"
      }
    },
    {
      "left": {
        "field": "label",
        "file": "metadata.json",
        "op": "field",
        "source": "deliverable"
      },
      "op": "eq",
      "right": {
        "op": "literal",
        "type": "string",
        "value": "release-5"
      }
    }
  ],
  "version": 1
}
