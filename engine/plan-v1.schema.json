{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UBC26 typed plan v1",
  "type": "object",
  "required": [
    "version",
    "deliverables",
    "references",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "references": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/expression"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$",
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "kind": {
      "enum": [
        "bool",
        "i64",
        "string"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parser"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "parser": {
          "enum": [
            "json/v1",
            "text/v1",
            "opaque/v1"
          ]
        },
        "fields": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "$ref": "#/$defs/kind"
              }
            }
          }
        },
        "collections": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/collection"
          }
        }
      },
      "if": {
        "properties": {
          "parser": {
            "enum": [
              "text/v1",
              "opaque/v1"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "maxItems": 0
          },
          "collections": {
            "maxItems": 0
          }
        }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "source",
            "file"
          ],
          "properties": {
            "op": {
              "const": "field"
            },
            "source": {
              "enum": [
                "deliverable",
                "reference",
                "evidence"
              ]
            },
            "file": {
              "$ref": "#/$defs/name"
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "type",
            "value"
          ],
          "properties": {
            "op": {
              "const": "literal"
            },
            "type": {
              "$ref": "#/$defs/kind"
            },
            "value": {}
          },
          "oneOf": [
            {
              "properties": {
                "type": {
                  "const": "bool"
                },
                "value": {
                  "type": "boolean"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "i64"
                },
                "value": {
                  "type": "string",
                  "pattern": "^-?[0-9]+$"
                }
              }
            },
            {
              "properties": {
                "type": {
                  "const": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "value": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "enum": [
                "add",
                "sub",
                "mul",
                "lt",
                "lte",
                "gt",
                "gte",
                "eq",
                "ne",
                "and",
                "or"
              ]
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "field"
          ],
          "properties": {
            "op": {
              "const": "record_field"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "collection"
          ],
          "properties": {
            "op": {
              "const": "count"
            },
            "collection": {
              "$ref": "#/$defs/collectionAccess"
            },
            "where": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "collection",
            "value"
          ],
          "properties": {
            "op": {
              "const": "sum"
            },
            "collection": {
              "$ref": "#/$defs/collectionAccess"
            },
            "value": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "collection",
            "where"
          ],
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "collection": {
              "$ref": "#/$defs/collectionAccess"
            },
            "where": {
              "$ref": "#/$defs/expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "collection",
            "field"
          ],
          "properties": {
            "op": {
              "const": "unique"
            },
            "collection": {
              "$ref": "#/$defs/collectionAccess"
            },
            "field": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "collection",
            "keyField",
            "key",
            "valueField"
          ],
          "properties": {
            "op": {
              "const": "lookup"
            },
            "collection": {
              "$ref": "#/$defs/collectionAccess"
            },
            "keyField": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "$ref": "#/$defs/expression"
            },
            "valueField": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fields"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "$ref": "#/$defs/kind"
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "collectionAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "file",
        "field"
      ],
      "properties": {
        "source": {
          "enum": [
            "deliverable",
            "reference",
            "evidence"
          ]
        },
        "file": {
          "$ref": "#/$defs/name"
        },
        "field": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parser",
        "profile",
        "signer"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "parser": {
          "enum": [
            "json/v1",
            "text/v1",
            "opaque/v1"
          ]
        },
        "fields": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "$ref": "#/$defs/kind"
              }
            }
          }
        },
        "collections": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/collection"
          }
        },
        "profile": {
          "enum": [
            "ed25519/v1",
            "eip712/v1",
            "jws/Ed25519/v1",
            "jws/EdDSA/v1",
            "jws/ES256/v1",
            "jws/RS256/v1"
          ]
        },
        "signer": {
          "type": "string",
          "pattern": "^0x(?:[0-9A-Fa-f]{2})+$"
        },
        "bindings": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "file"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "file": {
                "$ref": "#/$defs/name"
              }
            }
          }
        },
        "contextField": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "parser": {
            "enum": [
              "text/v1",
              "opaque/v1"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "fields": {
            "maxItems": 0
          },
          "collections": {
            "maxItems": 0
          }
        }
      }
    }
  }
}
