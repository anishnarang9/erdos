# Copy outside the checkout. Set mode 0600. Never add wallet/signing credentials.
# Fill approved service budgets and credentials before public startup.
# The image supplies source/engine/compiler pins. Compose supplies origin and paths.
BUYER_API_TOKEN=
# Required for legacy server initialization; public auth rejects this shared token.
# Generate a separate random value. It is not a buyer's wallet or API key.
OPERATOR_TOKEN=
AUTHORING_REQUIRED=1
EXPENSIVE_OPS_DISABLED=1
RATE_LIMIT_PRINCIPAL=12
RATE_LIMIT_IP=24
TASK_PENDING_GLOBAL=100
TASK_PENDING_PER_WALLET=20
AUTH_LIMIT_IP=20
AUTH_LIMIT_WINDOW_MS=60000
REQUEST_LOG=1
REQUEST_LOG_DEBUG=0
# Callback bootstrap only. Keep off until the dedicated service credential is configured.
# This profile never dispatches a paid Bot task and keeps public readiness false when enabled.
BOT_REVIEW_REQUIRED=0
BOT_REVIEW_SERVICE_TOKEN=
# For a reviewed one-wallet live pilot, configure the private webhook and dispatch cap.
# The public pilot permits up to four Bot dispatches and five distinct drafts.
# Set these limits only for an authorized run. Check remaining daily spend headroom first.
# Without it, the draft limit equals BOT_REVIEW_PILOT_MAX_DISPATCHES.
# Positive global cap for active plus waiting paid compile handlers.
PAID_COMPILE_LIMIT=2
# Optional extra exact frontend origin; omit to allow only SERVICE_ORIGIN.
# BROWSER_ORIGIN=https://frontend.example.test
XAI_MODEL=grok-4.20-0309-non-reasoning
XAI_API_KEY=
AUTHORING_REQUEST_CEILING_MICRO_USD=
AUTHORING_DAILY_CEILING_MICRO_USD=
# Reviewed highest context tier. These prices do not authorize any spend.
AUTHORING_INPUT_MICRO_USD_PER_MILLION=2500000
AUTHORING_OUTPUT_MICRO_USD_PER_MILLION=5000000

# Image startup checks these against its immutable deployment manifests.
CHAIN_RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
CHAIN_CORE=0x4992b29bc494a6d9A33D153850C0E40F15F0e9c8
CHAIN_HOOK=0x699d0e4a067F31229Be67C534B37dE964b6eDbAb
CHAIN_USDC=0x3600000000000000000000000000000000000000
INDEX_FROM_BLOCK=72393888
OPEN_CLAIM_RPC_URL=https://rpc.testnet.arc.io
OPEN_CLAIM_CHAIN_ID=5042002
OPEN_CLAIM_CORE=0x4992b29bc494a6d9A33D153850C0E40F15F0e9c8
OPEN_CLAIM_ADAPTER=0x1fEd5e532A1405FAcD45b4096aD1ABf25BbA0CB8
OPEN_CLAIM_USDC=0x3600000000000000000000000000000000000000
OPEN_CLAIM_VERIFIER=0xCf8D70A203b40D3A17d023c0CDDF752870BC3992
OPEN_CLAIM_CONFIRMATIONS=3
# Add Circle service-payment settings only after a separate payment preview.
