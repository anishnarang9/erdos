{
	log default {
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
	admin off
	email {$UBC26_TLS_EMAIL}
}
{$UBC26_HOSTNAME} {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# The operator publishes only verified standalone runner assets in this mount.
	@runner_downloads path /downloads/runner /downloads/runner/*
	handle @runner_downloads {
		@runner_asset {
			path_regexp runner_asset "^/downloads/runner/[0-9a-f]{40}/(ubc26-runner-0[.]2[.]0[.]tgz|SHA256SUMS|release[.]json|ubc26-release[.]json)$"
			method GET HEAD
		}
		header Cache-Control "public, max-age=0, must-revalidate"
		handle @runner_asset {
			root * /srv/ubc26-downloads
			uri strip_prefix /downloads/runner
			file_server
		}
		handle {
			respond 404
		}
	}
	# The authenticated result endpoint uses its own liveness upstream.
	handle /integrations/grok-bot/mcp {
		reverse_proxy bot-review-ingress:8080 {
			health_uri /healthz
			health_interval 5s
			health_timeout 3s
			health_status 2xx
		}
	}
	handle {
		reverse_proxy api:8080 {
			health_uri /readyz
			health_interval 5s
			health_timeout 3s
			health_status 2xx
			health_fails 1
			health_passes 1
		}
	}
}
