# Administrative configuration only. Keep the API secret file outside this directory.
# Prefer an immutable registry image digest; a local sha256 image ID also works.
UBC26_IMAGE=
UBC26_HOSTNAME=
UBC26_TLS_EMAIL=
UBC26_API_ENV=/etc/ubc26/api.env
UBC26_STATE_DIR=/srv/ubc26-state
UBC26_BACKUP_DIR=/srv/ubc26-backups
# Root-owned directory containing only reviewed public assets in SOURCE_SHA subdirectories.
UBC26_RUNNER_DIR=/opt/ubc26-release/public-runner
UBC26_DOCKER_GID=
